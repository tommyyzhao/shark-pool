# Surfshark service credentials (NOT your account email/password).
# https://my.surfshark.com/ → VPN → Manual Setup → OpenVPN / IKEv2 credentials
SURFSHARK_USERNAME=
SURFSHARK_PASSWORD=

# Optional overrides
